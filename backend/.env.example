# KLASSIO — modèle de configuration.
#
#   cp backend/.env.example backend/.env
#
# Copié tel quel, ce fichier donne un environnement de DÉVELOPPEMENT complet et
# sûr : base SQLite locale de démonstration, aucun e-mail envoyé, aucune
# connexion à un service extérieur. Il n'y a RIEN à remplir pour tester Klassio.
#
# RÈGLE : ce fichier est public. Il ne contient et ne contiendra jamais une
# vraie valeur — ni clé, ni mot de passe, ni chaîne de connexion, ni adresse
# d'infrastructure réelle. Les vraies valeurs vivent dans backend/.env (ignoré
# par git) ou dans les variables d'environnement de l'hébergeur.
# backend/tests/test_depot_public.py échoue si une valeur sensible y apparaît.
#
# Légende :  [DEV]  utile en développement   [PROD]  requis en production
#            [SECRET]  à ne jamais publier    [PUBLIC]  visible sans risque
#
# Klassio ne lit AUCUNE autre variable. En particulier, il n'existe aucune clé
# de paiement, de Mobile Money, de SMS, d'IA, d'OAuth ni d'analytics : ces
# intégrations ne sont pas construites. N'en ajoutez pas ici « pour préparer ».


# ===========================================================================
# BASE DE DONNÉES
# ===========================================================================

# Moteur de stockage.                                    [DEV] [PROD]
#   sqlite    fichier local — le défaut, et le seul utile en développement.
#   postgres  la production. Exige DATABASE_URL ci-dessous.
KLASSIO_DB_BACKEND=sqlite

# Fichier SQLite. Relatif = depuis backend/.               [DEV]
# `klassio_demo.db` est la base FICTIVE que remplit
#   python backend/tools/demo.py
# Vide = backend/klassio.db, la base de travail du propriétaire du projet :
# les outils de démonstration refusent d'y écrire.
KLASSIO_DB_PATH=klassio_demo.db

# Journal SQLite : `delete` (défaut) ou `wal` (meilleur sous charge, tests
# deux fois plus lents — voir backend/db.py).              [DEV] facultatif
KLASSIO_SQLITE_JOURNAL=

# Chaîne de connexion PostgreSQL.                          [PROD] [SECRET]
# Laisser VIDE en développement. Render et Heroku la posent d'eux-mêmes sous
# ce nom : elle n'a pas à être recopiée à la main.
# Pour un PostgreSQL local de test (facultatif) :
#   DATABASE_URL=postgresql://postgres:MOT_DE_PASSE_LOCAL@localhost:5432/klassio_dev
# Les outils de démonstration refusent toute base PostgreSQL DISTANTE.
#
# Si la base est chez Supabase : prenez l'adresse du POOLER
# (<region>.pooler.supabase.com, utilisateur postgres.<ref>), pas la connexion
# directe db.<ref>.supabase.co — publiée en IPv6 seulement, elle est
# injoignable depuis un réseau IPv4. Le bouton « Connect » du tableau de bord
# donne la bonne chaîne ; vérifiez avec python backend/tools/pg_check.py.
DATABASE_URL=

# Ancien nom de la même chaîne, lu seulement si DATABASE_URL est vide.
# Gardé pour ne pas casser les configurations existantes.  [PROD] [SECRET]
SUPABASE_DB_URL=

# Connexions PostgreSQL gardées ouvertes entre deux requêtes. Sans effet en
# SQLite.                                                   [PROD] facultatif
KLASSIO_PG_POOL_SIZE=5

# Schéma PostgreSQL de travail. Vide = `public`. Sert uniquement à isoler la
# suite de tests dans une base réelle (tools/pg_tests.py --supabase).
KLASSIO_PG_SCHEMA=

# Base SQLite SOURCE de tools/pg_migrate.py. Vide = backend/klassio.db.
KLASSIO_SQLITE_PATH=


# ===========================================================================
# RÉSEAU
# ===========================================================================

# Domaines du frontend autorisés à appeler l'API, séparés par des virgules.
# http://localhost:4173 et http://127.0.0.1:4173 sont TOUJOURS autorisés :
# vide suffit en développement. Le joker « * » est refusé.  [PROD] [PUBLIC]
#   KLASSIO_ALLOWED_ORIGINS=https://app.exemple.cd
KLASSIO_ALLOWED_ORIGINS=

# Adresse publique du frontend, pour fabriquer les liens des messages.
#                                                           [PROD] [PUBLIC]
KLASSIO_APP_URL=http://localhost:4173

# PORT et WEB_CONCURRENCY sont posés par l'hébergeur (Procfile, render.yaml),
# pas ici. En développement, l'API écoute toujours sur le port 5001.


# ===========================================================================
# E-MAIL — backend/mailer.py
# ===========================================================================

# capture     (défaut) RIEN ne part ; seules les métadonnées sont enregistrées.
#             Le mode du développement et des tests.
# production  le fournisseur est réellement appelé — exige EMAIL_API_KEY.
# fail        simule une panne du fournisseur, pour éprouver les reprises.
EMAIL_MODE=capture
EMAIL_PROVIDER=brevo
# Clé du fournisseur. Inutile en mode capture.              [PROD] [SECRET]
EMAIL_API_KEY=
# Expéditeur, sur un domaine vérifié (SPF/DKIM).            [PROD] [PUBLIC]
EMAIL_FROM=
EMAIL_FROM_NAME=Klassio


# ===========================================================================
# SUPABASE — FACULTATIF, même en production
# ===========================================================================
#
# Klassio n'utilise Supabase QUE comme hébergeur PostgreSQL (via DATABASE_URL).
# Aucune requête de l'application n'appelle son API REST. Ces trois valeurs ne
# servent qu'à la bannière de démarrage et à tools/supabase_check.py : laissez-
# les vides, rien ne s'en trouve privé.

# URL du projet, https://<ref>.supabase.co                  [PUBLIC]
SUPABASE_URL=
# Clé publiable (sb_publishable_…, ex-« anon »). Conçue pour le navigateur,
# protégée par la RLS — mais Klassio ne l'envoie jamais au navigateur.
#                                                            [PUBLIC]
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (sb_secret_…, ex-« service_role »). Contourne la RLS.
# Klassio n'en a besoin pour AUCUNE fonctionnalité.         [SECRET]
SUPABASE_SECRET_KEY=
