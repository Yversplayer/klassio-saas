# KLASSIO — variables d'environnement.
#
# Copiez ce fichier en `backend/.env` et complétez-le. Le fichier `.env` n'est
# jamais versionné et n'est jamais envoyé au navigateur.
#
#   cp backend/.env.example backend/.env
#
# Où trouver ces valeurs dans Supabase :
#   Project Settings → API            → URL du projet et clé « anon / publishable »
#   Project Settings → API            → clé « service_role » (secrète, serveur uniquement)
#   Project Settings → Database       → Connection string (URI, avec le mot de passe de la base)

# --- Projet Supabase ---------------------------------------------------------
# L'URL du projet. L'URL de l'API REST (…/rest/v1/) est acceptée telle quelle.
SUPABASE_URL=https://zpcbppwibrdpblnpslvf.supabase.co

# Clé publiable (« anon »). Conçue pour être visible côté navigateur ; elle ne
# protège rien par elle-même, c'est la Row Level Security qui protège.
SUPABASE_ANON_KEY=

# Clé de service. Contourne toutes les politiques RLS : elle ne doit JAMAIS
# se retrouver dans une page, un dépôt public ou un message. Facultative tant
# que Klassio n'écrit pas dans Supabase.
SUPABASE_SERVICE_KEY=

# Chaîne de connexion Postgres — c'est elle, et non les clés ci-dessus, qui
# permet à Klassio de stocker réellement ses données dans Supabase.
#
# ATTENTION : prenez l'adresse du POOLER, pas la connexion directe.
#   Direct   db.<ref>.supabase.co        publié en IPv6 seulement → inutilisable
#                                        depuis un réseau IPv4 (le cas ici).
#   Pooler   <region>.pooler.supabase.com joignable en IPv4, utilisateur de la
#                                        forme postgres.<ref>.
# Le bouton « Connect » du tableau de bord donne la bonne chaîne.
# Le mot de passe n'est plus consultable après création : s'il est perdu,
# Project Settings → Database → Reset database password.
#
# Exemple : postgresql://postgres.abcdefgh:MOT_DE_PASSE@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#
# Vérifiez ensuite avec : python3 backend/tools/pg_check.py
SUPABASE_DB_URL=

# --- Moteur de stockage ------------------------------------------------------
# sqlite   : base locale `backend/klassio.db` (état actuel, fonctionnel)
# postgres : base Supabase (à n'activer qu'après migration et vérification)
KLASSIO_DB_BACKEND=sqlite

# --- Réserve de connexions PostgreSQL ---------------------------------------
# Nombre de connexions gardées ouvertes entre deux requêtes. Sans réserve,
# chaque requête HTTP authentifiée ouvre DEUX connexions (résolution de session
# puis route), soit deux poignées de main TCP+TLS+auth à chaque fois. Sans
# effet en mode sqlite.
KLASSIO_PG_POOL_SIZE=5

# --- Origines autorisées (CORS) ----------------------------------------------
# Les origines de développement (http://localhost:4173, http://127.0.0.1:4173)
# sont toujours acceptées. Ajouter ici le ou les domaines réels du frontend,
# séparés par des virgules. Le joker « * » est refusé par construction.
# Exemple : KLASSIO_ALLOWED_ORIGINS=https://app.klassio.com,https://klassio.com
KLASSIO_ALLOWED_ORIGINS=

# --- Base SQLite de développement -------------------------------------------
# Chemin du fichier SQLite. Vide = backend/klassio.db. Utile pour lancer le
# serveur sur une base jetable sans toucher à la base de travail.
KLASSIO_DB_PATH=

# --- Journalisation SQLite (développement / charge) --------------------------
# `delete` (défaut) ou `wal`. WAL améliore la concurrence sous charge mais
# ralentit la suite de tests de plus du double — voir le commentaire dans
# backend/db.py. Sans effet en PostgreSQL.
KLASSIO_SQLITE_JOURNAL=
