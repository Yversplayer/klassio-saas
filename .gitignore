# Klassio — ce qui ne doit JAMAIS quitter cette machine.
#
# Deux catégories, pour deux raisons différentes. Ne retirez une ligne qu'en
# sachant laquelle des deux vous rouvrez.

# ---------------------------------------------------------------------------
# 1. SECRETS. Une fois poussés, ils sont compromis — même effacés au commit
#    suivant, ils restent dans l'historique et dans les copies déjà clonées.
# ---------------------------------------------------------------------------
backend/.env
.env
*.env
# Variantes d'environnement (.env.local, .env.production, .env.staging…) :
# chacune peut porter les vraies valeurs. Seul le MODÈLE est publié.
.env.*
!.env.example
!*.env.example
!backend/.env.example
# Clés privées, certificats, fichiers d'identifiants de fournisseurs.
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
id_ecdsa*
credentials*.json
service-account*.json
secrets.*

# ---------------------------------------------------------------------------
# 2. DONNÉES RÉELLES. `klassio.db` contient des élèves mineurs nommés, leurs
#    responsables, des paiements et des empreintes de mots de passe. Publier
#    ce fichier serait une violation de données, pas une maladresse.
# ---------------------------------------------------------------------------
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/klassio.db.avant-*
# Vidages et sauvegardes : une copie de base reste une base.
*.dump
*.sql.gz
*.backup
*.bak
# Fichiers déposés par les utilisateurs et journaux d'exécution : ils
# contiennent des noms, des pièces justificatives, des adresses.
uploads/
logs/
*.log

# ---------------------------------------------------------------------------
# 3. Reconstructible — inutile de le versionner.
# ---------------------------------------------------------------------------
backend_venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
# Aucune chaîne de build aujourd'hui (le frontend est servi tel quel) — ces
# lignes empêchent qu'un outil ajouté demain ne publie ses artefacts.
node_modules/
dist/
build/
.cache/

# Sorties brutes de k6 : les résumés .json sont gardés (REPRISE y renvoie),
# les vidages console ne servent qu'une fois.
tools/k6/resultats/**/*.txt

# macOS
.DS_Store
exports_store/
